]LYA.UDGa]"><field name="VAR" id="@1G#W!w|M4uo=L+o*UpH">myTextSprite3</field></block></value><value name="text"><shadow type="text" id="xXU1aW(h;QERQ2=-*4bD"><field name="TEXT">Tires can influence your handling and how long you stay on track. Different tires have different amounts of tire life. Once your tire life reaches zero your handling will be impacted significantly for the worse. Different tire types are as follows: Hard tries last the longest but give the least amount of grip on a track. Soft Tires last the shortest but give you the most amount of grip on the track. Medium tires last an average amount of time and have little to no effect on performance. </field></shadow></value><next><block type="spritesetpos" id="p8w`unoQ=X4qz_mpZZ.3"><value name="sprite"><block type="variables_get" id="8Hl88N*8.vpfL:h3Deg!"><field name="VAR" id="@1G#W!w|M4uo=L+o*UpH">myTextSprite3</field></block></value><value name="x"><shadow type="positionPicker" id="*3P.PkShsWtTj9_x^puN"><field name="index">119</field></shadow></value><value name="y"><shadow type="positionPicker" id="~%M;w|(kWZDnIAgC120F"><field name="index">205</field></shadow></value><next><block type="spriteutilmoveto" id="{BW@Er-F$E$BhUV5m-5+"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><value name="sprite"><block type="variables_get" id="B=RQ9HU!I0lb}9c91(dz"><field name="VAR" id="@1G#W!w|M4uo=L+o*UpH">myTextSprite3</field></block></value><value name="location"><shadow type="spriteutilpoint" id="]t;Fi^d/A:X7i2_l*0yC" disabled-reasons="pxt_automatic_disabled"><value name="x"><shadow type="math_number" id="uM!#!}tLV1Vc=?QUTIyK" disabled-reasons="pxt_automatic_disabled"><field name="NUM">0</field></shadow></value><value name="y"><shadow type="math_number" id=":riY#b}u%iCxXUw+UFQ!" disabled-reasons="pxt_automatic_disabled"><field name="NUM">0</field></shadow></value></shadow><block type="spriteutilpoint" id="T6TO8T+rnnq[uQ%=i1g1"><value name="x"><shadow type="math_number" i